        <mxCell id="X5ilICROq1YAWeTVaS0U-82" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=15;fillColor=#f8f8f8;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;Collaborators&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="300" x="1642" y="3333" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-83" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fillColor=#ffffff;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;Knows&lt;/b&gt;&lt;br&gt;• Account ID, name, optional email and phone.&lt;br&gt;• Roles, camping preferences, settings, creation time and removal&lt;br&gt;metadata.&lt;br&gt;Account capabilities: ENTRANT, OWNER, and ADMIN; an account can&lt;br&gt;hold multiple roles.&lt;br&gt;Preferred campsite tags and amenities, stored as sets without duplicates.&lt;br&gt;Notification Preference and palette preference, font and control-seze&lt;br&gt;preferences&lt;br&gt;&lt;b&gt;Does&lt;/b&gt;&lt;br&gt;• Validate that a non-removed account has a non-blank name and at least&lt;br&gt;one role.&lt;br&gt;• Derive isActive from the absence of removal metadata.&lt;br&gt;Provide default settings and validate positive, finite size scales&lt;br&gt;• Create a default entrant account.&lt;br&gt;• Update profile, preferences, and settings while preserving unrelated&lt;br&gt;fields.&lt;br&gt;• Enable owner capability without granting ADMIN.&lt;br&gt;• Reject changes to inactive accounts." vertex="1">
          <mxGeometry height="421" width="520" x="1122" y="3368" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-84" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fillColor=#ffffff;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="Role&lt;br&gt;Preferences&lt;br&gt;AccountSettings&lt;br&gt;Removal&lt;br&gt;Database" vertex="1">
          <mxGeometry height="421" width="300" x="1642" y="3368" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-85" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fillColor=#f8f8f8;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="Existing | Ownership: domain / account&lt;br&gt;References: US 01.07.03, 01.08.01, 03.11.01, 01.10.01; optional WOW 6 and personalization&lt;br&gt;Boundary: Holds account data and validates its invariants. Persistence, device authentication and removal cleanup belong to&lt;br&gt;other components." vertex="1">
          <mxGeometry height="98" width="820" x="1122" y="3789" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-86" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=19;fillColor=#f1f1f1;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;ProfileUI(ncludes profile and settings screen responsibilities.)&lt;/b&gt;" vertex="1">
          <mxGeometry height="44" width="820" x="1122" y="3917" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-87" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=15;fillColor=#f8f8f8;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;Responsibilities&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="520" x="1122" y="3961" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-88" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=15;fillColor=#f8f8f8;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;Collaborators&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="300" x="1642" y="3961" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-89" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fillColor=#ffffff;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;Knows&lt;/b&gt;&lt;br&gt;• Current account ID, observed profile, edit draft and operation state.&lt;br&gt;• Profile, notification-setting, and camping-preference drafts.&lt;br&gt;• Loading, saving, and error state.&lt;br&gt;&lt;b&gt;Does&lt;/b&gt;&lt;br&gt;• Load profile and validate edits; save through Database.&lt;br&gt;• Preserve input on failure and report confirmed results.&lt;br&gt;• Confirm removal and delegate to Administration&lt;br&gt;• Delegate image operations to the shared image controller.&lt;br&gt;&amp;#x27;&lt;br&gt;• Display and edit notification preferences and camping interests.&lt;br&gt;• Save changes through AccountRepository, preserving unrelated&lt;br&gt;settings.&lt;br&gt;• Retain unsaved input after failures." vertex="1">
          <mxGeometry height="316" width="520" x="1122" y="3996" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-90" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fillColor=#ffffff;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="Database&lt;br&gt;Account&lt;br&gt;Administration&lt;br&gt;ImageManager&lt;br&gt;Session/Device" vertex="1">
          <mxGeometry height="316" width="300" x="1642" y="3996" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-91" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fillColor=#f8f8f8;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="Planned | Ownership: ui / controller / account&lt;br&gt;References: US 01.07.03, 01.08.01; Image Upload&lt;br&gt;Boundary: Planned proposal. No direct Firebase access or manual cascade deletion; naming and shared collaborators require&lt;br&gt;agreement." vertex="1">
          <mxGeometry height="98" width="820" x="1122" y="4312" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-92" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=19;fillColor=#f1f1f1;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;ImageManager&lt;/b&gt;" vertex="1">
          <mxGeometry height="44" width="820" x="270" y="3917" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-93" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=15;fillColor=#f8f8f8;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;Responsibilities&lt;/b&gt;" vertex="1">
