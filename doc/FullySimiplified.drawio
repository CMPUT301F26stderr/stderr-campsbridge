        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-94" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=15;fillColor=#f8f8f8;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;Collaborators&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="300" x="790" y="3961" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-95" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fillColor=#ffffff;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;Knows&lt;/b&gt;&lt;br&gt;• The account/campsite image slot and current attachment.&lt;br&gt;• Selected image, upload progress, and cleanup status.&lt;br&gt;&lt;b&gt;Does&lt;/b&gt;&lt;br&gt;• Select, display, upload, replace, and remove images.&lt;br&gt;• Handle cancellation and upload failures.&lt;br&gt;• Check uncertain publication before retrying or deleting files.&lt;br&gt;• Request safe cleanup of obsolete images." vertex="1">
          <mxGeometry height="316" width="520" x="270" y="3996" as="geometry" />
        </mxCell>
        <mxCell id="X5ilICROq1YAWeTVaS0U-96" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fillColor=#ffffff;strokeColor=#222222;fontColor=#222222;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" value="Account&lt;br&gt;ProfileUI&lt;br&gt;Campsite&lt;br&gt;Database&lt;br&gt;CampsiteManagementUI" vertex="1">
          <mxGeometry height="316" width="300" x="790" y="3996" as="geometry" />
