        <mxCell id="afk6OYJIJqATBkYILG2x-8" parent="afk6OYJIJqATBkYILG2x-7" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;Knows&lt;/b&gt;&lt;br&gt;• Current identity/account and selected interface role.&lt;br&gt;• Initialization state and foreground-work lifecycle.&lt;br&gt;&lt;br&gt;&lt;b&gt;Does&lt;/b&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;ul&gt;&lt;li&gt;Show workspaces allowed by the account’s roles.&lt;/li&gt;&lt;li&gt;Switch workspaces while keeping the same account identity.&lt;/li&gt;&lt;li&gt;Request owner capability through &lt;code dir=&quot;ltr&quot;&gt;AccountRepository&lt;/code&gt;; never grant ADMIN.&lt;/li&gt;&lt;li&gt;&amp;nbsp;Bootstrap device identity and retrieve or initialize the account.&lt;/li&gt;&lt;li&gt;&amp;nbsp;Expose session state, initialization errors, and retry actions.&lt;/li&gt;&lt;li&gt;Arrange foreground execution of resumable work after initialization.&lt;/li&gt;&lt;li&gt;Establish or retrieve device-linked identity without username/password login.&lt;/li&gt;&lt;li&gt;Supply the account ID and report initialization failures.&lt;/li&gt;&lt;li&gt;notification-token registration/removal&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="356" width="455" x="10" y="30" as="geometry" />
        </mxCell>
