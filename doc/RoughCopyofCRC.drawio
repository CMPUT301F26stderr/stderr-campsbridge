        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-95" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=23;align=left;verticalAlign=top;spacing=18;fontStyle=0;" value="&lt;p&gt;&lt;strong&gt;Knows&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;The account/campsite image slot and current attachment.&lt;/li&gt;&lt;li&gt;Selected image, upload progress, and cleanup status.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Does&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Select, display, upload, replace, and remove images.&lt;/li&gt;&lt;li&gt;Handle cancellation and upload failures.&lt;/li&gt;&lt;li&gt;Check uncertain publication before retrying or deleting files.&lt;/li&gt;&lt;li&gt;Request safe cleanup of obsolete images.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="470" width="690" x="330" y="5080" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-96" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=23;align=left;verticalAlign=top;spacing=18;fontStyle=0;" value="Account&lt;br&gt;Profile UI&lt;br&gt;Campsite&lt;br&gt;Database&lt;div&gt;Campsite Management UI&lt;/div&gt;" vertex="1">
          <mxGeometry height="470" width="460" x="1020" y="5080" as="geometry" />
