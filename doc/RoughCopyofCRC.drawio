        <mxCell id="afk6OYJIJqATBkYILG2x-69" parent="1" style="swimlane;html=1;horizontal=1;startSize=34;align=center;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;swimlaneFillColor=default;collapsible=0;rounded=0;" value="LotteryController" vertex="1">
          <mxGeometry height="445" width="760" x="690" y="4490" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-70" parent="afk6OYJIJqATBkYILG2x-69" style="swimlane;html=1;horizontal=1;startSize=30;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;swimlaneFillColor=default;collapsible=0;rounded=0;" value="Responsibilities" vertex="1">
          <mxGeometry height="324" width="460" y="34" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-71" parent="afk6OYJIJqATBkYILG2x-70" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;swimlaneFillColor=default;" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;p&gt;&lt;strong&gt;Knows&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Current account and role.&lt;/li&gt;&lt;li&gt;Selected lottery, owner drafts, participant lists, and entrant results.&lt;/li&gt;&lt;li&gt;Loading, submission, and error state.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Does&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Let owners configure offers, publish lotteries, inspect participants, and request draws.&lt;/li&gt;&lt;li&gt;Let entrants view lotteries, join or withdraw, view results, and decline offers.&lt;/li&gt;&lt;li&gt;Open booking choices for selected entrants.&lt;/li&gt;&lt;li&gt;Preserve input and show operation results.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="324" width="450" x="10" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-72" parent="afk6OYJIJqATBkYILG2x-69" style="swimlane;html=1;horizontal=1;startSize=30;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;swimlaneFillColor=default;collapsible=0;rounded=0;" value="Collaborators" vertex="1">
          <mxGeometry height="324" width="310" x="450" y="34" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-73" parent="afk6OYJIJqATBkYILG2x-72" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;swimlaneFillColor=default;" value="&lt;div style=&quot;line-height:1.45&quot;&gt;• Lottery&lt;br&gt;• Campsite&amp;nbsp;&lt;br&gt;• Reservation / booking Manager&lt;br&gt;• Notification Manager&lt;/div&gt;" vertex="1">
          <mxGeometry height="294" width="310" y="30" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-74" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;swimlaneFillColor=default;" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="87" width="760" x="690" y="4848" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-75" parent="1" style="swimlane;html=1;horizontal=1;startSize=34;align=center;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;swimlaneFillColor=default;collapsible=0;rounded=0;" value="Reservation/BookingManager&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="445" width="760" x="1610" y="3860" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-76" parent="afk6OYJIJqATBkYILG2x-75" style="swimlane;html=1;horizontal=1;startSize=30;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;swimlaneFillColor=default;collapsible=0;rounded=0;" value="Responsibilities" vertex="1">
          <mxGeometry height="366" width="450" y="34" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-77" parent="afk6OYJIJqATBkYILG2x-76" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;swimlaneFillColor=default;" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;Knows&lt;/b&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Entrant, campsite, lottery win, stay dates, and guests.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Price, accepted terms, simulated payment/refund, and reservation status.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;p&gt;&lt;/p&gt;&lt;br&gt;&lt;b&gt;Does&lt;/b&gt;&lt;br&gt;&lt;li&gt;Display booking choices and reservation history.&lt;/li&gt;&lt;li&gt;Validate eligibility, availability, guests, price, and accepted rules.&lt;/li&gt;&lt;li&gt;Coordinate booking, payment recording, and night claims.&lt;/li&gt;&lt;li&gt;Cancel/reject reservations, refund, and release nights.&lt;/li&gt;&lt;li&gt;Prevent double booking and repeated refunds; keep used wins consumed.&lt;/li&gt;&lt;li&gt;Request notifications, CSV export, and reservation-map display.&lt;/li&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="294" width="450" y="30" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-78" parent="afk6OYJIJqATBkYILG2x-75" style="swimlane;html=1;horizontal=1;startSize=30;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;swimlaneFillColor=default;collapsible=0;rounded=0;" value="Collaborators" vertex="1">
          <mxGeometry height="360" width="310" x="450" y="34" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-79" parent="afk6OYJIJqATBkYILG2x-78" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;swimlaneFillColor=default;" value="&lt;div style=&quot;line-height:1.45&quot;&gt;Account, Campsite, Lottery&lt;/div&gt;&lt;div style=&quot;line-height:1.45&quot;&gt;Database&lt;/div&gt;&lt;div style=&quot;line-height:1.45&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;line-height:1.45&quot;&gt;NotificatonManager&lt;/div&gt;&lt;div style=&quot;line-height:1.45&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;line-height:1.45&quot;&gt;Platform Services&lt;/div&gt;&lt;div style=&quot;line-height:1.45&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="310" y="30" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-80" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=30;align=center;verticalAlign=top;spacing=18;fontStyle=1;" value="Account &lt;font style=&quot;font-size: 12px;&quot;&gt;(include Role, Preferences, AccountSetting, and colorMode)&lt;/font&gt;" vertex="1">
          <mxGeometry height="54" width="1150" x="1535" y="4340" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-81" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=23;align=center;verticalAlign=top;spacing=18;fontStyle=2;" value="Responsibilities" vertex="1">
          <mxGeometry height="46" width="690" x="1535" y="4394" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-82" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=23;align=center;verticalAlign=top;spacing=18;fontStyle=2;" value="Collaborators" vertex="1">
          <mxGeometry height="46" width="460" x="2225" y="4394" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-83" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=23;align=left;verticalAlign=top;spacing=18;fontStyle=0;" value="&lt;b&gt;Knows&lt;/b&gt;&lt;br&gt;• Account ID, name, optional email and phone.&lt;br&gt;• Roles, camping preferences, settings, creation time and removal metadata.&lt;div&gt;Account capabilities: &lt;code dir=&quot;ltr&quot;&gt;ENTRANT&lt;/code&gt;, &lt;code dir=&quot;ltr&quot;&gt;OWNER&lt;/code&gt;, and &lt;code dir=&quot;ltr&quot;&gt;ADMIN&lt;/code&gt;; an account can hold multiple roles.&lt;/div&gt;&lt;div&gt;Preferred campsite tags and amenities, stored as sets without duplicates.&lt;/div&gt;&lt;div&gt;Notification Preference and palette preference, font and control-seze preferences&lt;/div&gt;&lt;div&gt;&lt;b&gt;Does&lt;/b&gt;&lt;br&gt;• Validate that a non-removed account has a non-blank name and at least one role.&lt;br&gt;• Derive isActive from the absence of removal metadata.&lt;/div&gt;&lt;div&gt;Provide default settings and validate positive, finite size scales&lt;/div&gt;&lt;div&gt;&lt;li&gt;Create a default entrant account.&lt;/li&gt;&lt;li&gt;Update profile, preferences, and settings while preserving unrelated fields.&lt;/li&gt;&lt;li&gt;Enable owner capability without granting ADMIN.&lt;/li&gt;&lt;li&gt;Reject changes to inactive accounts.&lt;/li&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="635" width="690" x="1535" y="4440" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-84" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=23;align=left;verticalAlign=top;spacing=18;fontStyle=0;" value="Role&lt;br&gt;Preferences&lt;br&gt;AccountSettings&lt;br&gt;Removal&lt;div&gt;Database&lt;/div&gt;" vertex="1">
          <mxGeometry height="635" width="460" x="2225" y="4440" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-85" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=18;fontStyle=0;" value="Existing | Ownership: domain / account&lt;br&gt;References: US 01.07.03, 01.08.01, 03.11.01, 01.10.01; optional WOW 6 and personalization&lt;br&gt;Boundary: Holds account data and validates its invariants. Persistence, device authentication and removal cleanup belong to other components." vertex="1">
          <mxGeometry height="144" width="1150" x="1535" y="5075" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-86" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=30;align=center;verticalAlign=top;spacing=18;fontStyle=1;" value="ProfileUI&lt;font style=&quot;font-size: 14px;&quot;&gt;(ncludes profile and settings screen responsibilities.)&lt;/font&gt;" vertex="1">
          <mxGeometry height="54" width="1150" x="1520" y="5295" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-87" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=23;align=center;verticalAlign=top;spacing=18;fontStyle=2;" value="Responsibilities" vertex="1">
