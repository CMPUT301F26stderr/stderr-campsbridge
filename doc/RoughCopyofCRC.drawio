        <mxCell id="afk6OYJIJqATBkYILG2x-34" parent="afk6OYJIJqATBkYILG2x-33" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;div&gt;Knows&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Selected campsite, calendar nights, and pending availability edits.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Does&lt;/div&gt;&lt;div&gt;&lt;li&gt;Display offered, booked, and unavailable nights.&lt;/li&gt;&lt;li&gt;Let owners offer or withdraw unreserved nights.&lt;/li&gt;&lt;li&gt;Show save results and retain unsaved changes after failure.&lt;/li&gt;&lt;li&gt;Display published campsites for entrants.&lt;/li&gt;&lt;li&gt;Display the current owner’s campsite listings.&lt;/li&gt;&lt;li&gt;Open a selected campsite’s details.&lt;/li&gt;&lt;li&gt;Allow owners to create and edit their listings.&lt;/li&gt;&lt;li&gt;Allow owners to publish a listing&lt;/li&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
