        <mxCell id="afk6OYJIJqATBkYILG2x-5" parent="afk6OYJIJqATBkYILG2x-4" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Account,&lt;/div&gt;&lt;div style=&quot;line-height:1.4&quot;&gt;Campsite&lt;/div&gt;&lt;div style=&quot;line-height:1.4&quot;&gt;Discovery&lt;/div&gt;&lt;div style=&quot;line-height:1.4&quot;&gt;Database&lt;/div&gt;" vertex="1">
