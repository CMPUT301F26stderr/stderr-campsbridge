        <mxCell id="afk6OYJIJqATBkYILG2x-3" parent="afk6OYJIJqATBkYILG2x-2" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b&gt;Knows&lt;/b&gt;&lt;br&gt;&lt;/div&gt;&lt;li&gt;Campsite and author, rating, review text, and timestamps.&lt;/li&gt;&lt;li&gt;Thread replies, parent references, and account reactions.&lt;/li&gt;&lt;li&gt;Unsaved rating/reply input and operation state.&lt;/li&gt;&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;br&gt;&lt;b&gt;Does&lt;/b&gt;&lt;br&gt;&lt;/div&gt;&lt;ul&gt;&lt;li&gt;Display reviews, rating summaries, replies, and reactions.&lt;/li&gt;&lt;li&gt;Create or update an account’s campsite rating.&lt;/li&gt;&lt;li&gt;Validate ratings from 1–5 and nonblank replies.&lt;/li&gt;&lt;li&gt;Ensure replies belong to the same review thread.&lt;/li&gt;&lt;li&gt;Set, replace, or remove an account’s reaction.&lt;/li&gt;&lt;li&gt;Preserve input after failures.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;p&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="334" width="540" y="30" as="geometry" />
