        <mxCell id="afk6OYJIJqATBkYILG2x-13" parent="afk6OYJIJqATBkYILG2x-12" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b&gt;Knows&lt;/b&gt;&lt;br&gt;Device permissions, supported campsite links, export formats, and alert settings.&lt;br&gt;&lt;br&gt;&lt;b&gt;Does&lt;/b&gt;&lt;br&gt;&lt;/div&gt;&lt;li&gt;Request device location and handle permission denial.&lt;/li&gt;&lt;li&gt;Generate and scan campsite QR codes.&lt;/li&gt;&lt;li&gt;Export confirmed reservation/cancellation details as CSV.&lt;/li&gt;&lt;li&gt;Display OS alerts according to notification preferences.&lt;/li&gt;&lt;li&gt;Route QR scans and alert taps to the relevant screen.&lt;/li&gt;&lt;li&gt;Report cancellation, unavailable services, and failures.&lt;/li&gt;" vertex="1">
