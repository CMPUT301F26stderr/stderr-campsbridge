        <mxCell id="afk6OYJIJqATBkYILG2x-2" parent="afk6OYJIJqATBkYILG2x-1" style="swimlane;html=1;horizontal=1;startSize=30;align=center;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=2;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#222222;collapsible=0;rounded=0;" value="Responsibilities" vertex="1">
