        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-88" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=23;align=center;verticalAlign=top;spacing=18;fontStyle=2;" value="Collaborators" vertex="1">
          <mxGeometry height="46" width="460" x="2210" y="5349" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-89" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=23;align=left;verticalAlign=top;spacing=18;fontStyle=0;" value="&lt;b&gt;Knows&lt;/b&gt;&lt;br&gt;• Current account ID, observed profile, edit draft and operation state.&lt;div&gt;&lt;li&gt;Profile, notification-setting, and camping-preference drafts.&lt;/li&gt;&lt;li&gt;Loading, saving, and error state.&lt;/li&gt;&lt;br&gt;&lt;b&gt;Does&lt;/b&gt;&lt;br&gt;• Load profile and validate edits; save through Database.&lt;br&gt;• Preserve input on failure and report confirmed results.&lt;br&gt;• Confirm removal and delegate to Administration&lt;br&gt;• Delegate image operations to the shared image controller.&lt;/div&gt;&lt;div&gt;&#39;&lt;/div&gt;&lt;ul&gt;&lt;li&gt;Display and edit notification preferences and camping interests.&lt;/li&gt;&lt;li&gt;Save changes through &lt;code dir=&quot;ltr&quot;&gt;AccountRepository&lt;/code&gt;, preserving unrelated settings.&lt;/li&gt;&lt;li&gt;Retain unsaved input after failures.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="567" width="690" x="1520" y="5395" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-90" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=23;align=left;verticalAlign=top;spacing=18;fontStyle=0;" value="Database&lt;div&gt;Account&lt;/div&gt;&lt;div&gt;Administration&lt;/div&gt;&lt;div&gt;ImageManage&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;r&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Seesion/Device&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="567" width="460" x="2210" y="5395" as="geometry" />
        </mxCell>
        <mxCell id="afk6OYJIJqATBkYILG2x-91" parent="1" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=18;fontStyle=0;" value="Planned | Ownership: ui / controller / account&lt;br&gt;References: US 01.07.03, 01.08.01; Image Upload&lt;br&gt;Boundary: Planned proposal. No direct Firebase access or manual cascade deletion; naming and shared collaborators require agreement." vertex="1">
          <mxGeometry height="144" width="1150" x="1520" y="5962" as="geometry" />
        </mxCell>
