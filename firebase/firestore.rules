// Defines document access and coordinated-write rules for accounts, campsites,
// lotteries, reservations, notifications and image metadata.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function account(id) { return get(/databases/$(database)/documents/accounts/$(id)).data; }
    function active() { return signed() && account(request.auth.uid).removal == null; }
    function activeRole(name) {
      let actor = account(request.auth.uid);
      return actor.removal == null && name in actor.roles;
    }
    function role(name) { return signed() && activeRole(name); }
    function admin() { return role('ADMIN'); }
    function site(id) { return get(/databases/$(database)/documents/campsites/$(id)).data; }
    function lottery(id) { return get(/databases/$(database)/documents/lotteries/$(id)).data; }
    function ownsSite(id) { return role('OWNER') && site(id).ownerId == request.auth.uid; }
    function ownsLotteryData(l) { return l.ownerId == request.auth.uid && role('OWNER'); }
    function ownsLottery(id) { return signed() && ownsLotteryData(lottery(id)); }
    function lotteryMember(l) { return role('OWNER') && request.auth.uid in l.participantOwnerIds; }
    function lotteryRemovalActor(l) {
      return removalActor(l.ownerId)
        || (signed() && request.auth.uid in l.participantOwnerIds && removalActor(request.auth.uid));
    }
    function lotteryReader(l) {
      return signed() && (l.publishedAt != null || l.ownerId == request.auth.uid
        || lotteryMember(l) || lotteryRemovalActor(l) || admin());
    }
    function changes(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function pair(a, b) { return string(a.size()) + ':' + a + string(b.size()) + ':' + b; }
    function triple(a, b, c) { return pair(a, b) + string(c.size()) + ':' + c; }
    function stringList(value) {
      // Round-tripping preserves element types; join alone coerces non-strings.
      return value is list && (value.size() == 0 || value == value.join('\u0000').split('\u0000'));
    }
    function validSettings(value) {
      return value is map && value.keys().hasAll(['notificationsEnabled', 'colorMode', 'fontScale', 'controlScale'])
        && value.keys().hasOnly(['notificationsEnabled', 'colorMode', 'fontScale', 'controlScale'])
        && value.notificationsEnabled is bool && value.colorMode in ['STANDARD', 'COLOR_BLIND']
        && value.fontScale is number && value.fontScale >= 0.25 && value.fontScale <= 4.0
        && value.controlScale is number && value.controlScale >= 0.25 && value.controlScale <= 4.0;
    }
    function validPreferences(value) {
      return value is map && value.keys().hasAll(['tags', 'amenities']) && value.keys().hasOnly(['tags', 'amenities'])
        && stringList(value.tags) && stringList(value.amenities);
    }
    function validAccount(value) {
      return value.keys().hasAll(['name', 'email', 'phone', 'roles', 'preferences', 'settings', 'createdAt', 'removal'])
        && value.keys().hasOnly(['name', 'email', 'phone', 'roles', 'preferences', 'settings', 'createdAt', 'removal'])
        && value.name is string && (value.removal != null || value.name.trim().size() > 0)
        && (value.email == null || value.email is string) && (value.phone == null || value.phone is string)
        && value.roles is list && value.roles.hasOnly(['ENTRANT', 'OWNER', 'ADMIN'])
        && (value.removal != null || value.roles.size() > 0)
        && validPreferences(value.preferences) && validSettings(value.settings) && value.createdAt is timestamp && validRemoval(value.removal);
    }
    function validTimeZone(value) {
      // Names from the pinned JDK, split below the rules regex-size limit.
      return value.matches("(?:Africa/Abidjan|Africa/Accra|Africa/Addis_Ababa|Africa/Algiers|Africa/Asmara|Africa/Asmera|Africa/Bamako|Africa/Bangui|Africa/Banjul|Africa/Bissau|Africa/Blantyre|Africa/Brazzaville|Africa/Bujumbura|Africa/Cairo|Africa/Casablanca|Africa/Ceuta|Africa/Conakry|Africa/Dakar|Africa/Dar_es_Salaam|Africa/Djibouti|Africa/Douala|Africa/El_Aaiun|Africa/Freetown|Africa/Gaborone|Africa/Harare|Africa/Johannesburg|Africa/Juba|Africa/Kampala|Africa/Khartoum|Africa/Kigali|Africa/Kinshasa|Africa/Lagos|Africa/Libreville|Africa/Lome|Africa/Luanda|Africa/Lubumbashi|Africa/Lusaka|Africa/Malabo|Africa/Maputo|Africa/Maseru|Africa/Mbabane|Africa/Mogadishu|Africa/Monrovia|Africa/Nairobi|Africa/Ndjamena|Africa/Niamey|Africa/Nouakchott|Africa/Ouagadougou|Africa/Porto\\-Novo|Africa/Sao_Tome|Africa/Timbuktu|Africa/Tripoli|Africa/Tunis|Africa/Windhoek|America/Adak|America/Anchorage|America/Anguilla|America/Antigua|America/Araguaina|America/Argentina/Buenos_Aires|America/Argentina/Catamarca|America/Argentina/ComodRivadavia|America/Argentina/Cordoba|America/Argentina/Jujuy|America/Argentina/La_Rioja|America/Argentina/Mendoza|America/Argentina/Rio_Gallegos|America/Argentina/Salta|America/Argentina/San_Juan|America/Argentina/San_Luis|America/Argentina/Tucuman|America/Argentina/Ushuaia|America/Aruba|America/Asuncion|America/Atikokan|America/Atka|America/Bahia|America/Bahia_Banderas|America/Barbados|America/Belem|America/Belize|America/Blanc\\-Sablon|America/Boa_Vista|America/Bogota|America/Boise|America/Buenos_Aires|America/Cambridge_Bay|America/Campo_Grande|America/Cancun|America/Caracas|America/Catamarca|America/Cayenne|America/Cayman|America/Chicago|America/Chihuahua|America/Ciudad_Juarez|America/Coral_Harbour|America/Cordoba|America/Costa_Rica|America/Coyhaique|America/Creston|America/Cuiaba|America/Curacao|America/Danmarkshavn|America/Dawson|America/Dawson_Creek|America/Denver|America/Detroit|America/Dominica|America/Edmonton|America/Eirunepe|America/El_Salvador|America/Ensenada|America/Fort_Nelson|America/Fort_Wayne|America/Fortaleza|America/Glace_Bay|America/Godthab|America/Goose_Bay|America/Grand_Turk|America/Grenada|America/Guadeloupe|America/Guatemala|America/Guayaquil|America/Guyana|America/Halifax|America/Havana|America/Hermosillo|America/Indiana/Indianapolis|America/Indiana/Knox|America/Indiana/Marengo|America/Indiana/Petersburg|America/Indiana/Tell_City|America/Indiana/Vevay|America/Indiana/Vincennes|America/Indiana/Winamac|America/Indianapolis|America/Inuvik|America/Iqaluit|America/Jamaica|America/Jujuy|America/Juneau|America/Kentucky/Louisville|America/Kentucky/Monticello|America/Knox_IN|America/Kralendijk|America/La_Paz|America/Lima|America/Los_Angeles|America/Louisville|America/Lower_Princes|America/Maceio|America/Managua|America/Manaus|America/Marigot|America/Martinique|America/Matamoros|America/Mazatlan|America/Mendoza|America/Menominee|America/Merida|America/Metlakatla|America/Mexico_City|America/Miquelon|America/Moncton|America/Monterrey|America/Montevideo)")
        || value.matches("(?:America/Montreal|America/Montserrat|America/Nassau|America/New_York|America/Nipigon|America/Nome|America/Noronha|America/North_Dakota/Beulah|America/North_Dakota/Center|America/North_Dakota/New_Salem|America/Nuuk|America/Ojinaga|America/Panama|America/Pangnirtung|America/Paramaribo|America/Phoenix|America/Port\\-au\\-Prince|America/Port_of_Spain|America/Porto_Acre|America/Porto_Velho|America/Puerto_Rico|America/Punta_Arenas|America/Rainy_River|America/Rankin_Inlet|America/Recife|America/Regina|America/Resolute|America/Rio_Branco|America/Rosario|America/Santa_Isabel|America/Santarem|America/Santiago|America/Santo_Domingo|America/Sao_Paulo|America/Scoresbysund|America/Shiprock|America/Sitka|America/St_Barthelemy|America/St_Johns|America/St_Kitts|America/St_Lucia|America/St_Thomas|America/St_Vincent|America/Swift_Current|America/Tegucigalpa|America/Thule|America/Thunder_Bay|America/Tijuana|America/Toronto|America/Tortola|America/Vancouver|America/Virgin|America/Whitehorse|America/Winnipeg|America/Yakutat|America/Yellowknife|Antarctica/Casey|Antarctica/Davis|Antarctica/DumontDUrville|Antarctica/Macquarie|Antarctica/Mawson|Antarctica/McMurdo|Antarctica/Palmer|Antarctica/Rothera|Antarctica/South_Pole|Antarctica/Syowa|Antarctica/Troll|Antarctica/Vostok|Arctic/Longyearbyen|Asia/Aden|Asia/Almaty|Asia/Amman|Asia/Anadyr|Asia/Aqtau|Asia/Aqtobe|Asia/Ashgabat|Asia/Ashkhabad|Asia/Atyrau|Asia/Baghdad|Asia/Bahrain|Asia/Baku|Asia/Bangkok|Asia/Barnaul|Asia/Beirut|Asia/Bishkek|Asia/Brunei|Asia/Calcutta|Asia/Chita|Asia/Choibalsan|Asia/Chongqing|Asia/Chungking|Asia/Colombo|Asia/Dacca|Asia/Damascus|Asia/Dhaka|Asia/Dili|Asia/Dubai|Asia/Dushanbe|Asia/Famagusta|Asia/Gaza|Asia/Harbin|Asia/Hebron|Asia/Ho_Chi_Minh|Asia/Hong_Kong|Asia/Hovd|Asia/Irkutsk|Asia/Istanbul|Asia/Jakarta|Asia/Jayapura|Asia/Jerusalem|Asia/Kabul|Asia/Kamchatka|Asia/Karachi|Asia/Kashgar|Asia/Kathmandu|Asia/Katmandu|Asia/Khandyga|Asia/Kolkata|Asia/Krasnoyarsk|Asia/Kuala_Lumpur|Asia/Kuching|Asia/Kuwait|Asia/Macao|Asia/Macau|Asia/Magadan|Asia/Makassar|Asia/Manila|Asia/Muscat|Asia/Nicosia|Asia/Novokuznetsk|Asia/Novosibirsk|Asia/Omsk|Asia/Oral|Asia/Phnom_Penh|Asia/Pontianak|Asia/Pyongyang|Asia/Qatar|Asia/Qostanay|Asia/Qyzylorda|Asia/Rangoon|Asia/Riyadh|Asia/Saigon|Asia/Sakhalin|Asia/Samarkand|Asia/Seoul|Asia/Shanghai|Asia/Singapore|Asia/Srednekolymsk|Asia/Taipei|Asia/Tashkent|Asia/Tbilisi|Asia/Tehran|Asia/Tel_Aviv|Asia/Thimbu|Asia/Thimphu|Asia/Tokyo|Asia/Tomsk|Asia/Ujung_Pandang|Asia/Ulaanbaatar|Asia/Ulan_Bator|Asia/Urumqi|Asia/Ust\\-Nera|Asia/Vientiane|Asia/Vladivostok|Asia/Yakutsk|Asia/Yangon|Asia/Yekaterinburg|Asia/Yerevan|Atlantic/Azores|Atlantic/Bermuda|Atlantic/Canary|Atlantic/Cape_Verde|Atlantic/Faeroe|Atlantic/Faroe|Atlantic/Jan_Mayen|Atlantic/Madeira|Atlantic/Reykjavik|Atlantic/South_Georgia|Atlantic/St_Helena|Atlantic/Stanley|Australia/ACT|Australia/Adelaide|Australia/Brisbane|Australia/Broken_Hill|Australia/Canberra|Australia/Currie|Australia/Darwin|Australia/Eucla|Australia/Hobart|Australia/LHI)")
        || value.matches("(?:Australia/Lindeman|Australia/Lord_Howe|Australia/Melbourne|Australia/NSW|Australia/North|Australia/Perth|Australia/Queensland|Australia/South|Australia/Sydney|Australia/Tasmania|Australia/Victoria|Australia/West|Australia/Yancowinna|Brazil/Acre|Brazil/DeNoronha|Brazil/East|Brazil/West|CET|CST6CDT|Canada/Atlantic|Canada/Central|Canada/Eastern|Canada/Mountain|Canada/Newfoundland|Canada/Pacific|Canada/Saskatchewan|Canada/Yukon|Chile/Continental|Chile/EasterIsland|Cuba|EET|EST5EDT|Egypt|Eire|Etc/GMT|Etc/GMT\\+0|Etc/GMT\\+1|Etc/GMT\\+10|Etc/GMT\\+11|Etc/GMT\\+12|Etc/GMT\\+2|Etc/GMT\\+3|Etc/GMT\\+4|Etc/GMT\\+5|Etc/GMT\\+6|Etc/GMT\\+7|Etc/GMT\\+8|Etc/GMT\\+9|Etc/GMT\\-0|Etc/GMT\\-1|Etc/GMT\\-10|Etc/GMT\\-11|Etc/GMT\\-12|Etc/GMT\\-13|Etc/GMT\\-14|Etc/GMT\\-2|Etc/GMT\\-3|Etc/GMT\\-4|Etc/GMT\\-5|Etc/GMT\\-6|Etc/GMT\\-7|Etc/GMT\\-8|Etc/GMT\\-9|Etc/GMT0|Etc/Greenwich|Etc/UCT|Etc/UTC|Etc/Universal|Etc/Zulu|Europe/Amsterdam|Europe/Andorra|Europe/Astrakhan|Europe/Athens|Europe/Belfast|Europe/Belgrade|Europe/Berlin|Europe/Bratislava|Europe/Brussels|Europe/Bucharest|Europe/Budapest|Europe/Busingen|Europe/Chisinau|Europe/Copenhagen|Europe/Dublin|Europe/Gibraltar|Europe/Guernsey|Europe/Helsinki|Europe/Isle_of_Man|Europe/Istanbul|Europe/Jersey|Europe/Kaliningrad|Europe/Kiev|Europe/Kirov|Europe/Kyiv|Europe/Lisbon|Europe/Ljubljana|Europe/London|Europe/Luxembourg|Europe/Madrid|Europe/Malta|Europe/Mariehamn|Europe/Minsk|Europe/Monaco|Europe/Moscow|Europe/Nicosia|Europe/Oslo|Europe/Paris|Europe/Podgorica|Europe/Prague|Europe/Riga|Europe/Rome|Europe/Samara|Europe/San_Marino|Europe/Sarajevo|Europe/Saratov|Europe/Simferopol|Europe/Skopje|Europe/Sofia|Europe/Stockholm|Europe/Tallinn|Europe/Tirane|Europe/Tiraspol|Europe/Ulyanovsk|Europe/Uzhgorod|Europe/Vaduz|Europe/Vatican|Europe/Vienna|Europe/Vilnius|Europe/Volgograd|Europe/Warsaw|Europe/Zagreb|Europe/Zaporozhye|Europe/Zurich|GB|GB\\-Eire|GMT|GMT0|Greenwich|Hongkong|Iceland|Indian/Antananarivo|Indian/Chagos|Indian/Christmas|Indian/Cocos|Indian/Comoro|Indian/Kerguelen|Indian/Mahe|Indian/Maldives|Indian/Mauritius|Indian/Mayotte|Indian/Reunion|Iran|Israel|Jamaica|Japan|Kwajalein|Libya|MET|MST7MDT|Mexico/BajaNorte|Mexico/BajaSur|Mexico/General|NZ|NZ\\-CHAT|Navajo|PRC|PST8PDT|Pacific/Apia|Pacific/Auckland|Pacific/Bougainville|Pacific/Chatham|Pacific/Chuuk|Pacific/Easter|Pacific/Efate|Pacific/Enderbury|Pacific/Fakaofo|Pacific/Fiji|Pacific/Funafuti|Pacific/Galapagos|Pacific/Gambier|Pacific/Guadalcanal|Pacific/Guam|Pacific/Honolulu|Pacific/Johnston|Pacific/Kanton|Pacific/Kiritimati|Pacific/Kosrae|Pacific/Kwajalein|Pacific/Majuro|Pacific/Marquesas|Pacific/Midway|Pacific/Nauru|Pacific/Niue|Pacific/Norfolk|Pacific/Noumea|Pacific/Pago_Pago|Pacific/Palau|Pacific/Pitcairn|Pacific/Pohnpei|Pacific/Ponape|Pacific/Port_Moresby|Pacific/Rarotonga|Pacific/Saipan|Pacific/Samoa|Pacific/Tahiti|Pacific/Tarawa|Pacific/Tongatapu|Pacific/Truk|Pacific/Wake|Pacific/Wallis|Pacific/Yap|Poland|Portugal|ROK|Singapore|SystemV/AST4|SystemV/AST4ADT|SystemV/CST6|SystemV/CST6CDT|SystemV/EST5)")
        || value.matches("(?:SystemV/EST5EDT|SystemV/HST10|SystemV/MST7|SystemV/MST7MDT|SystemV/PST8|SystemV/PST8PDT|SystemV/YST9|SystemV/YST9YDT|Turkey|UCT|US/Alaska|US/Aleutian|US/Arizona|US/Central|US/East\\-Indiana|US/Eastern|US/Hawaii|US/Indiana\\-Starke|US/Michigan|US/Mountain|US/Pacific|US/Samoa|UTC|Universal|W\\-SU|WET|Zulu)")
        || value.matches('(UTC|GMT|UT)?[+-]((0[0-9]|1[0-7])(:[0-5][0-9])?|18(:00)?)');
    }
    function validRemoval(value) {
      return value == null || (value is map && value.keys().hasAll(['at', 'actorId', 'reason'])
        && value.keys().hasOnly(['at', 'actorId', 'reason']) && value.at is timestamp
        && value.actorId is string && value.actorId.size() > 0 && (value.reason == null || value.reason is string));
    }
    function validSite(value) {
      return value.keys().hasAll(['ownerId', 'name', 'description', 'location', 'locationLabel', 'timeZone', 'maxGuests',
          'amenities', 'tags', 'nightlyPriceCents', 'rules', 'createdAt', 'publishedAt', 'removal'])
        && value.keys().hasOnly(['ownerId', 'name', 'description', 'location', 'locationLabel', 'timeZone', 'maxGuests',
          'amenities', 'tags', 'nightlyPriceCents', 'rules', 'createdAt', 'publishedAt', 'removal'])
        && value.ownerId is string && value.name is string && value.name.trim().size() > 0
        && value.description is string && value.location is latlng && value.locationLabel is string
        && value.timeZone is string && validTimeZone(value.timeZone)
        && value.maxGuests is int && value.maxGuests > 0 && value.nightlyPriceCents is int && value.nightlyPriceCents >= 0
        && stringList(value.amenities) && stringList(value.tags) && value.rules is string
        && value.createdAt is timestamp && (value.publishedAt == null || value.publishedAt is timestamp) && validRemoval(value.removal);
    }
    function recordedRemovalActor(removal) {
      return signed() && removal != null && removal.actorId == request.auth.uid;
    }
    function removalActor(id) { return recordedRemovalActor(account(id).removal); }
    // Lottery authority and lifecycle checks also serve its coordinated child writes.
    function registrationEligible(l) {
      return l.publishedAt != null && l.cancellation == null && l.drawnAt == null
        && request.time >= l.registrationOpensAt && request.time < l.registrationClosesAt;
    }
    function registrationOpen(id) { return registrationEligible(lottery(id)); }
    function bookingEligible(l) {
      return l.publishedAt != null && l.cancellation == null && l.drawnAt != null
        && request.time >= l.bookingOpensAt && request.time < l.bookingClosesAt;
    }
    function drawAuthority(l) { return signed() && (lotteryMember(l) || admin()); }
    function drawOperator(id) { return drawAuthority(lottery(id)); }
    function drawEligible(l) {
      return l.publishedAt != null && l.cancellation == null && l.drawnAt == null
        && request.time >= l.registrationClosesAt;
    }
    function canDrawData(id, l) {
      return drawEligible(l) && (drawAuthority(l)
        || (lotteryRemovalActor(l) && exists(/databases/$(database)/documents/_draws/$(id))));
    }
    function canDraw(id) { return canDrawData(id, lottery(id)); }

    // Reservation participation is distinct from authority to finish recorded removal work.
    function participant(r) {
      return signed() && (r.entrantId == request.auth.uid || ownsSite(r.campsiteId));
    }
    function siteRemovalActor(id) {
      let s = site(id);
      return signed() && s.removal != null && s.removal.actorId == request.auth.uid;
    }
    function reservationRemovalActor(r) {
      return removalActor(r.entrantId) || siteRemovalActor(r.campsiteId);
    }
    function canCoordinateReservation(r) {
      return (active() && participant(r)) || admin() || reservationRemovalActor(r);
    }
    function imageOwner(id) {
      return signed() && (id == 'account_' + request.auth.uid
        || (id.matches('campsite_.+') && ownsSite(id.replace('^campsite_', ''))));
    }
    function removeImage(id) {
      return imageOwner(id) || admin()
        || (id.matches('account_.+') && removalActor(id.replace('^account_', '')))
        || (signed() && id.matches('campsite_.+') && site(id.replace('^campsite_', '')).removal != null
          && site(id.replace('^campsite_', '')).removal.actorId == request.auth.uid);
    }
    // Event processing follows the event's actual aggregate, never a global privileged session.
    function messageParticipant(id) {
      let message = get(/databases/$(database)/documents/messages/$(id)).data;
      let reservation = get(/databases/$(database)/documents/reservations/$(message.reservationId)).data;
      return participant(reservation);
    }
    function processEvent(e) {
      return admin() || (active() && e.senderId == request.auth.uid)
        || (e.subject.type == 'LOTTERY'
          && (drawAuthority(lottery(e.subject.id)) || lotteryRemovalActor(lottery(e.subject.id))))
        || (e.subject.type == 'RESERVATION'
          && canCoordinateReservation(get(/databases/$(database)/documents/reservations/$(e.subject.id)).data))
        || (e.subject.type == 'MESSAGE' && messageParticipant(e.subject.id));
    }

    function deliveryPath(e, eventId) {
      return e.subject.type == 'LOTTERY'
        ? /databases/$(database)/documents/lotteries/$(e.subject.id)/_notificationDeliveries/$(eventId)
        : e.subject.type == 'RESERVATION'
          ? /databases/$(database)/documents/reservations/$(e.subject.id)/_notificationDeliveries/$(eventId)
          : /databases/$(database)/documents/reservations/$(get(/databases/$(database)/documents/messages/$(e.subject.id)).data.reservationId)/_notificationDeliveries/$(eventId);
    }
    function deliveryEvent(eventId) { return getAfter(/databases/$(database)/documents/notifications/$(eventId)).data; }
    function messageRecipient(event, recipients) {
      let message = getAfter(/databases/$(database)/documents/messages/$(event.subject.id)).data;
      let r = get(/databases/$(database)/documents/reservations/$(message.reservationId)).data;
      return recipients == [message.senderId == r.entrantId ? site(r.campsiteId).ownerId : r.entrantId];
    }
    function validDelivery(eventId, event) {
      let recipients = request.resource.data.recipientIds;
      return signed() && request.resource.data.keys().hasOnly(['recipientIds']) && recipients is list
        && !exists(/databases/$(database)/documents/notifications/$(eventId)) && event.createdAt is timestamp
        && ((event.type in ['LOTTERY_WON', 'LOTTERY_LOST'] && recipients.size() == 1)
          || event.type == 'OWNER_ANNOUNCEMENT'
          || (event.subject.type == 'RESERVATION'
            && recipients == [getAfter(/databases/$(database)/documents/reservations/$(event.subject.id)).data.entrantId])
          || (event.subject.type == 'MESSAGE' && messageRecipient(event, recipients)));
    }

    match /accounts/{id} {
      allow read: if signed();
      allow create: if validAccount(request.resource.data) && signed() && id == request.auth.uid && request.resource.data.roles == ['ENTRANT']
        && request.resource.data.removal == null && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'roles', 'preferences', 'settings', 'createdAt', 'removal']);
      allow update: if validAccount(request.resource.data) && ((active() && id == request.auth.uid && resource.data.removal == null
          && changes(['name', 'email', 'phone', 'preferences', 'settings', 'roles'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && (request.resource.data.roles == resource.data.roles
            || request.resource.data.roles.toSet() == resource.data.roles.toSet().union(['OWNER'].toSet())))
        || (signed() && (id == request.auth.uid || admin())
          && changes(['name', 'email', 'phone', 'roles', 'preferences', 'settings', 'removal'])
          && request.resource.data.removal is map && request.resource.data.removal.at is timestamp
          && (resource.data.removal == null ? request.resource.data.removal.actorId == request.auth.uid
            : request.resource.data.removal == resource.data.removal)
          && request.resource.data.name == '' && request.resource.data.email == null && request.resource.data.phone == null
          && request.resource.data.roles == [] && request.resource.data.preferences == {'tags': [], 'amenities': []}
          && request.resource.data.settings.notificationsEnabled == false));
      match /devices/{device} {
        allow read: if signed() && (id == request.auth.uid || admin());
        allow create, update: if active() && id == request.auth.uid
          && request.resource.data.keys().hasOnly(['fcmToken', 'updatedAt'])
          && request.resource.data.fcmToken is string && request.resource.data.updatedAt is timestamp;
        allow delete: if signed() && (id == request.auth.uid || admin() || removalActor(id));
      }
      match /inbox/{eventId} {
        function e() { return get(/databases/$(database)/documents/notifications/$(eventId)).data; }
        function job() { return get(deliveryPath(e(), eventId)).data; }
        allow read: if signed() && (id == request.auth.uid || admin() || (id in job().recipientIds && processEvent(e())));
        allow create: if signed() && request.resource.data == {'readAt': null}
          && id in job().recipientIds && processEvent(e())
          && (!(e().type in ['LOTTERY_WON', 'LOTTERY_LOST']) || lottery(e().subject.id).drawnAt != null);
        allow update: if active() && id == request.auth.uid && changes(['readAt'])
          && resource.data.readAt == null && request.resource.data.readAt is timestamp;
      }
    }

    match /campsites/{id} {
      allow get: if signed() && (resource == null || resource.data.publishedAt != null || resource.data.ownerId == request.auth.uid || admin());
      allow list: if signed() && (resource.data.publishedAt != null || resource.data.ownerId == request.auth.uid || admin());
      allow create: if validSite(request.resource.data) && role('OWNER') && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.removal == null && request.resource.data.publishedAt == null
        && request.resource.data.maxGuests is int && request.resource.data.maxGuests > 0
        && request.resource.data.nightlyPriceCents is int && request.resource.data.nightlyPriceCents >= 0;
      allow update: if validSite(request.resource.data) && ((ownsSite(id) && resource.data.removal == null
          && changes(['name', 'description', 'location', 'locationLabel', 'timeZone', 'maxGuests', 'amenities', 'tags', 'nightlyPriceCents', 'rules', 'publishedAt'])
          && request.resource.data.maxGuests is int && request.resource.data.maxGuests > 0
          && request.resource.data.nightlyPriceCents is int && request.resource.data.nightlyPriceCents >= 0
          && (resource.data.publishedAt == null || request.resource.data.publishedAt == resource.data.publishedAt))
        || ((ownsSite(id) || admin() || removalActor(resource.data.ownerId)) && changes(['removal'])
          && request.resource.data.removal is map
          && (resource.data.removal == null
            ? (request.resource.data.removal.actorId == request.auth.uid || request.resource.data.removal == account(resource.data.ownerId).removal)
            : request.resource.data.removal == resource.data.removal)));
      match /calendar/{night} {
        allow read: if signed() && (site(id).publishedAt != null || ownsSite(id) || admin());
        allow create: if ownsSite(id) && site(id).removal == null
          && request.resource.data.keys().hasOnly(['isOffered', 'reservationId'])
          && request.resource.data.isOffered is bool && request.resource.data.reservationId == null;
        allow update: if (ownsSite(id) && site(id).removal == null && changes(['isOffered'])
          && request.resource.data.isOffered is bool && (request.resource.data.isOffered || resource.data.reservationId == null));
      }
      match /reviews/{author} {
        function validFeedback(d) {
          return d.keys().hasAll(['rating', 'body', 'createdAt', 'updatedAt'])
            && d.keys().hasOnly(['rating', 'body', 'createdAt', 'updatedAt'])
            && (d.rating == null || (d.rating is int && d.rating >= 1 && d.rating <= 5))
            && (d.body == null || (d.body is string && d.body.trim().size() > 0))
            && d.createdAt is timestamp && d.updatedAt is timestamp;
        }
        function authorWrite() {
          return role('ENTRANT') && author == request.auth.uid
            && site(id).publishedAt != null && site(id).removal == null;
        }
        function componentUpdate() {
          return (changes(['rating', 'updatedAt']) && request.resource.data.rating != resource.data.rating
              && request.resource.data.rating != null)
            || (changes(['body', 'updatedAt']) && request.resource.data.body != resource.data.body);
        }
        function moderatedUpdate() {
          return admin() && ((changes(['rating', 'updatedAt']) && resource.data.rating != null && request.resource.data.rating == null)
            || (changes(['body', 'updatedAt']) && resource.data.body != null && request.resource.data.body == null));
        }
        function hasContent() {
          let path = /databases/$(database)/documents/campsites/$(id)/reviews/$(author);
          return exists(path) && (get(path).data.rating != null || get(path).data.body != null);
        }
        allow read: if signed();
        allow create: if authorWrite() && validFeedback(request.resource.data)
          && (request.resource.data.rating != null || request.resource.data.body != null);
        allow update: if validFeedback(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && ((authorWrite() && componentUpdate()) || moderatedUpdate());
        match /replies/{reply} {
          allow read: if signed();
          allow create: if active() && request.resource.data.authorId == request.auth.uid
            && request.resource.data.keys().hasOnly(['authorId', 'parentReplyId', 'body', 'createdAt'])
            && request.resource.data.body is string && request.resource.data.body.size() > 0
            && hasContent()
            && (request.resource.data.parentReplyId == null || exists(
              /databases/$(database)/documents/campsites/$(id)/reviews/$(author)/replies/$(request.resource.data.parentReplyId)));
        }
        match /reactions/{reactor} {
          allow read: if signed();
          allow create, update: if active() && reactor == request.auth.uid
            && request.resource.data.keys().hasOnly(['type']) && request.resource.data.type in ['LIKE', 'HELPFUL']
            && hasContent();
          allow delete: if active() && reactor == request.auth.uid;
        }
      }
    }

    match /lotteries/{id} {
      function config(d) {
        return d.registrationOpensAt < d.registrationClosesAt && d.registrationClosesAt <= d.bookingOpensAt && d.bookingOpensAt < d.bookingClosesAt
          && stringList(d.participantOwnerIds) && d.ownerId in d.participantOwnerIds
          && d.participantOwnerIds.toSet().size() == d.participantOwnerIds.size()
          && d._revision is int && d._revision >= 0
          && d.winnerCount is int && d.winnerCount > 0 && d.waitingCount is int && d.waitingCount >= 0
          && (d.waitlistCapacity == null || (d.waitlistCapacity is int && d.waitlistCapacity > 0));
      }
      // Each parent update has one explicit operation owner; its child writes verify the pair.
      function memberCountUpdate(l, next) {
        let entryPath = /databases/$(database)/documents/lotteries/$(id)/entries/$(request.auth.uid);
        let after = getAfter(entryPath).data;
        return role('ENTRANT') && registrationEligible(l)
          && ((after.state == 'WAITING'
              && (!exists(entryPath) || get(entryPath).data.state == 'WITHDRAWN')
              && next.waitingCount == l.waitingCount + 1)
            || (after.state == 'WITHDRAWN' && get(entryPath).data.state == 'WAITING'
              && next.waitingCount == l.waitingCount - 1))
          && (l.waitlistCapacity == null || next.waitingCount <= l.waitlistCapacity);
      }
      function ownerConfigurationUpdate(l, next, fields) {
        return ownsLotteryData(l) && l.cancellation == null
          && next._revision == l._revision + 1
          && (l.publishedAt == null || request.time < l.registrationOpensAt
            || fields.hasOnly(['title', 'description', '_revision']))
          && (l.publishedAt == null || next.publishedAt == l.publishedAt);
      }
      function allocationRevisionUpdate(l, next) {
        return lotteryMember(l) && l.cancellation == null && l.drawnAt == null
          && (l.publishedAt == null || request.time < l.registrationOpensAt)
          && next._revision == l._revision + 1;
      }
      function drawCountUpdate(l, next) {
        return next.waitingCount in [l.waitingCount, l.waitingCount - 1] && canDrawData(id, l);
      }
      function drawCompletion(l, next) {
        return l.waitingCount == 0 && next.drawnAt is timestamp && canDrawData(id, l)
          && exists(/databases/$(database)/documents/_draws/$(id));
      }
      function adminCountUpdate(l, next) {
        return next.waitingCount == l.waitingCount - 1 && admin();
      }
      function removalWithdrawal(l, next) {
        let entryPath = /databases/$(database)/documents/lotteries/$(id)/entries/$(request.auth.uid);
        return next.waitingCount == l.waitingCount - 1 && request.time < l.registrationClosesAt
          && removalActor(request.auth.uid) && get(entryPath).data.state == 'WAITING'
          && getAfter(entryPath).data.state == 'WITHDRAWN';
      }
      function lotteryCancellation(l, next) {
        return l.cancellation == null && next.cancellation is map
          && (next.cancellation.actorId == request.auth.uid || admin())
          && (drawAuthority(l) || lotteryRemovalActor(l))
          && (!exists(/databases/$(database)/documents/_draws/$(id)) || l.drawnAt != null);
      }
      function countUpdate(l, next) {
        return memberCountUpdate(l, next) || drawCountUpdate(l, next)
          || adminCountUpdate(l, next) || removalWithdrawal(l, next);
      }
      function unchangedUpdate(l, next, fields) {
        // Empty diffs matched every old field allowlist; preserve that union explicitly.
        return ownerConfigurationUpdate(l, next, fields) || countUpdate(l, next)
          || drawCompletion(l, next) || lotteryCancellation(l, next);
      }
      function validUpdate() {
        let l = resource.data;
        let next = request.resource.data;
        let fields = next.diff(l).affectedKeys();
        return config(next) && (fields.size() == 0 ? unchangedUpdate(l, next, fields)
          : fields.hasOnly(['waitingCount']) ? countUpdate(l, next)
          : fields.hasOnly(['drawnAt']) ? drawCompletion(l, next)
          : fields.hasOnly(['cancellation']) ? lotteryCancellation(l, next)
          : fields.hasOnly(['_revision']) ? (allocationRevisionUpdate(l, next) || ownerConfigurationUpdate(l, next, fields))
          : fields.hasOnly(['title', 'description', 'registrationOpensAt', 'registrationClosesAt',
            'bookingOpensAt', 'bookingClosesAt', 'winnerCount', 'waitlistCapacity', 'publishedAt', 'participantOwnerIds', '_revision'])
            ? ownerConfigurationUpdate(l, next, fields) : false);
      }
      allow get: if signed() && (resource == null || lotteryReader(resource.data));
      allow list: if lotteryReader(resource.data);
      allow create: if role('OWNER') && request.resource.data.ownerId == request.auth.uid && config(request.resource.data)
        && request.resource.data.waitingCount == 0 && request.resource.data.publishedAt == null
        && request.resource.data.participantOwnerIds == [request.auth.uid]
        && request.resource.data.drawnAt == null && request.resource.data.cancellation == null;
      allow update: if validUpdate();
      match /offers/{campsite} {
        function editableOffer(l) {
          return l.cancellation == null && (l.publishedAt == null || request.time < l.registrationOpensAt)
            && lotteryMember(l);
        }
        function matchingRevision(l) {
          let next = getAfter(/databases/$(database)/documents/lotteries/$(id)).data;
          return next._revision == l._revision + 1;
        }
        function saveOffer() {
          let l = lottery(id);
          let s = site(campsite);
          let offer = request.resource.data;
          return offer.keys().hasOnly(['campsiteId', 'nights']) && offer.campsiteId == campsite
            && offer.nights is list && offer.nights.size() > 0
            && s.ownerId == request.auth.uid && s.removal == null
            && (l.participantOwnerIds.size() == 1 || s.publishedAt != null)
            && editableOffer(l) && matchingRevision(l);
        }
        function deleteOffer() {
          let l = lottery(id);
          return site(campsite).ownerId == request.auth.uid && editableOffer(l) && matchingRevision(l);
        }
        allow read: if lotteryReader(lottery(id));
        allow create, update: if signed() && saveOffer();
        allow delete: if signed() && deleteOffer();
      }
      match /entries/{entrant} {
        allow read: if signed() && (entrant == request.auth.uid || drawAuthority(lottery(id)) || lotteryRemovalActor(lottery(id)));
        allow create: if role('ENTRANT') && entrant == request.auth.uid && registrationOpen(id)
          && request.resource.data.accountId == entrant && request.resource.data.state == 'WAITING'
          && getAfter(/databases/$(database)/documents/lotteries/$(id)).data.waitingCount == lottery(id).waitingCount + 1;
        function memberTransition(l, old, next) {
          return next.state in ['WAITING', 'WITHDRAWN'] && old.state in ['WAITING', 'WITHDRAWN']
            && next.state != old.state && role('ENTRANT') && entrant == request.auth.uid
            && registrationEligible(l)
            && getAfter(/databases/$(database)/documents/lotteries/$(id)).data.waitingCount
              == l.waitingCount + (next.state == 'WAITING' ? 1 : -1);
        }
        function drawTransition(l, old, next) {
          return old.state == 'WAITING' && next.state in ['LOST', 'OFFERED'] && canDrawData(id, l)
            && exists(/databases/$(database)/documents/_draws/$(id))
            && getAfter(/databases/$(database)/documents/lotteries/$(id)).data.waitingCount == l.waitingCount - 1;
        }
        function declineTransition(l, old, next) {
          return old.state == 'OFFERED' && next.state == 'DECLINED' && role('ENTRANT')
            && entrant == request.auth.uid && bookingEligible(l)
            && !exists(/databases/$(database)/documents/reservations/$(pair(id, entrant)));
        }
        function removalTransition(l, old, next) {
          return old.state == 'WAITING' && next.state == 'WITHDRAWN'
            && request.time < l.registrationClosesAt && (admin() || removalActor(entrant))
            && account(entrant).removal != null
            && getAfter(/databases/$(database)/documents/lotteries/$(id)).data.waitingCount == l.waitingCount - 1;
        }
        function updateEntry() {
          let l = lottery(id);
          let old = resource.data;
          let next = request.resource.data;
          let fields = next.diff(old).affectedKeys();
          return next.accountId == old.accountId && (
            (fields.hasOnly(['state', 'joinedAt', 'stateChangedAt']) && memberTransition(l, old, next))
            || (fields.hasOnly(['state', 'stateChangedAt']) && (drawTransition(l, old, next)
              || declineTransition(l, old, next) || removalTransition(l, old, next))));
        }
        allow update: if signed() && updateEntry();
      }
    }
    match /{parent=**}/entries/{entry} { allow read: if signed() && (resource.data.accountId == request.auth.uid || admin()); }
    match /{parent=**}/offers/{offer} {
      allow read: if admin() || (signed() && site(resource.data.campsiteId).publishedAt != null
        && site(resource.data.campsiteId).removal == null);
    }

    match /reservations/{id} {
      allow get: if signed() && (resource == null || participant(resource.data) || admin() || reservationRemovalActor(resource.data));
      allow list: if participant(resource.data) || admin() || reservationRemovalActor(resource.data);
      // Only authenticated callable functions may coordinate reservation/payment/inventory writes.
      allow create, update, delete: if false;
    }
    match /messages/{id} {
      function r() { return get(/databases/$(database)/documents/reservations/$(resource.data.reservationId)).data; }
      allow get: if signed() && (resource == null || participant(r()) || admin());
      allow list: if participant(r()) || admin();
      allow create: if active() && request.resource.data.senderId == request.auth.uid
        && participant(get(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data)
        && request.resource.data.keys().hasOnly(['reservationId', 'senderId', 'body', 'createdAt', 'readAt'])
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.readAt == null;
      allow update: if active() && participant(r()) && resource.data.senderId != request.auth.uid
        && resource.data.readAt == null && changes(['readAt']) && request.resource.data.readAt is timestamp;
    }
    match /notifications/{id} {
      function announcementEvent(e) {
        return e.senderId == request.auth.uid && lotteryMember(lottery(e.subject.id)) && e.announcement is map;
      }
      function drawEvent(e) {
        let job = getAfter(/databases/$(database)/documents/lotteries/$(e.subject.id)/_notificationDeliveries/$(id)).data;
        return e.senderId == null && canDraw(e.subject.id) && job.recipientIds.size() == 1
          && id == triple(e.type, e.subject.id, job.recipientIds[0])
          && getAfter(/databases/$(database)/documents/lotteries/$(e.subject.id)/entries/$(job.recipientIds[0])).data.state
            == (e.type == 'LOTTERY_WON' ? 'OFFERED' : 'LOST');
      }
      function messageEvent(e) {
        return e.senderId == request.auth.uid && id == pair(e.type, e.subject.id)
          && getAfter(/databases/$(database)/documents/messages/$(e.subject.id)).data.senderId == request.auth.uid;
      }
      function validEvent(e) {
        return e.keys().hasOnly(['senderId', 'type', 'subject', 'announcement', 'createdAt']) && (
          (e.type == 'OWNER_ANNOUNCEMENT' && e.subject.type == 'LOTTERY' && announcementEvent(e))
          || (e.type in ['LOTTERY_WON', 'LOTTERY_LOST'] && e.subject.type == 'LOTTERY' && drawEvent(e))
          || (e.type == 'NEW_MESSAGE' && e.subject.type == 'MESSAGE' && messageEvent(e)));
      }
      function readable(e) {
        return signed() && (admin() || e.senderId == request.auth.uid
          || exists(/databases/$(database)/documents/accounts/$(request.auth.uid)/inbox/$(id)) || processEvent(e));
      }
      allow get: if signed() && (resource == null || readable(resource.data));
      allow list: if readable(resource.data);
      allow create: if signed() && validEvent(request.resource.data);
      allow update: if request.resource.data == resource.data && processEvent(resource.data);
    }
    match /lotteries/{lotteryId}/_notificationDeliveries/{id} {
      allow read, delete: if drawOperator(lotteryId) || lotteryRemovalActor(lottery(lotteryId));
      function createDelivery() {
        let event = deliveryEvent(id);
        return event.subject.type == 'LOTTERY' && event.subject.id == lotteryId && validDelivery(id, event);
      }
      allow create: if createDelivery();
    }
    match /reservations/{reservationId}/_notificationDeliveries/{id} {
      function r() { return get(/databases/$(database)/documents/reservations/$(reservationId)).data; }
      function scopeMatches(event) {
        return (event.subject.type == 'RESERVATION' && event.subject.id == reservationId)
          || (event.subject.type == 'MESSAGE'
            && getAfter(/databases/$(database)/documents/messages/$(event.subject.id)).data.reservationId == reservationId);
      }
      allow read, delete: if canCoordinateReservation(r());
      function createDelivery() {
        let event = deliveryEvent(id);
        return scopeMatches(event) && validDelivery(id, event);
      }
      allow create: if createDelivery();
    }
    match /{parent=**}/_notificationDeliveries/{id} { allow read: if admin(); }
    match /_draws/{id} {
      allow read: if drawOperator(id) || lotteryRemovalActor(lottery(id));
      allow create: if canDraw(id) && request.resource.data.keys().hasOnly(['seed']) && request.resource.data.seed is string;
    }
    match /images/{id} {
      allow get: if signed() && (resource == null || id.matches('account_.+') || admin()
        || (id.matches('campsite_.+') && (site(id.replace('^campsite_', '')).publishedAt != null || ownsSite(id.replace('^campsite_', '')))));
      allow list: if admin();
      function publishAttachment() {
        let next = request.resource.data;
        let intent = get(/databases/$(database)/documents/_imageUploads/$(next.blobId)).data;
        return active() && imageOwner(id) && next.keys().hasOnly(['blobId', 'uploadedAt'])
          && (id == 'account_' + request.auth.uid || site(id.replace('^campsite_', '')).removal == null)
          && intent.attachmentId == id && intent.abandoned == false
          && intent.uploadFinished == true && intent.expiresAt > request.time;
      }
      allow create, update: if publishAttachment();
      allow delete: if removeImage(id);
    }
    match /_imageUploads/{blob} {
      allow get: if signed() && (resource == null || admin() || removeImage(resource.data.attachmentId));
      allow list: if admin() || removeImage(resource.data.attachmentId);
      allow create: if active() && imageOwner(request.resource.data.attachmentId)
        && request.resource.data.keys().hasOnly(['attachmentId', 'expiresAt', 'abandoned', 'uploadFinished'])
        && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(16, 'm')
        && request.resource.data.abandoned == false && request.resource.data.uploadFinished == false;
      function finishUpload() {
        return changes(['uploadFinished']) && request.resource.data.uploadFinished == true
          && imageOwner(resource.data.attachmentId);
      }
      function abandonExpiredUpload() {
        return changes(['abandoned']) && request.resource.data.abandoned == true
          && resource.data.expiresAt <= request.time && removeImage(resource.data.attachmentId);
      }
      allow update: if finishUpload() || abandonExpiredUpload();
      allow delete: if removeImage(resource.data.attachmentId);
    }
    match /_storageCleanup/{blob} {
      allow get: if signed() && (resource == null || admin() || removeImage(resource.data.attachmentId));
      allow list: if admin() || removeImage(resource.data.attachmentId);
      allow delete: if admin() || (resource != null && removeImage(resource.data.attachmentId))
        || (resource == null && removeImage(get(/databases/$(database)/documents/_imageUploads/$(blob)).data.attachmentId));
      allow create: if removeImage(request.resource.data.attachmentId)
        && request.resource.data.keys().hasOnly(['queuedAt', 'attachmentId'])
        && get(/databases/$(database)/documents/images/$(request.resource.data.attachmentId)).data.blobId == blob;
    }
    match /_removals/{id} {
      allow read, delete: if admin() || (signed() && resource.data.actorId == request.auth.uid);
      allow create, update: if request.resource.data.at is timestamp
        && (admin() || (signed() && request.resource.data.actorId == request.auth.uid))
        && ((id.matches('account_.+') && getAfter(/databases/$(database)/documents/accounts/$(id.replace('^account_', ''))).data.removal == request.resource.data)
          || (id.matches('campsite_.+') && getAfter(/databases/$(database)/documents/campsites/$(id.replace('^campsite_', ''))).data.removal == request.resource.data));
    }
    // No client access to undeclared collections.
  }
}
